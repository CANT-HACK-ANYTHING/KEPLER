# Active AI Provider ('opencode', 'nvidia', or 'gemini')
AI_PROVIDER=opencode

# OpenCode Zen API Configuration (Active when AI_PROVIDER=opencode)
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_MODEL=nemotron-3.5-lightning-free

# NVIDIA API Configuration (Active when AI_PROVIDER=nvidia)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Google Gemini API Configuration (Active when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional: Dedicated API Key for the Student Progress Analyzer Model
# (Keeps Teacher/Analyzer rate limits separate from the Student Socratic Chat model)
ANALYZER_PROVIDER=gemini
ANALYZER_API_KEY=your_analyzer_api_key_here
ANALYZER_MODEL=gemini-3.5-flash-lite

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

